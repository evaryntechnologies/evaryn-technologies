import "server-only";

import { redirect } from "next/navigation";
import { createClient } from "@/lib/supabase/server";
import { prisma } from "@/lib/db/prisma";

export type PortalRole =
  | "TASKER"
  | "REVIEWER"
  | "QA"
  | "ADMIN"
  | "SUPER_ADMIN";

const PORTAL_ROLES: readonly PortalRole[] = [
  "TASKER",
  "REVIEWER",
  "QA",
  "ADMIN",
  "SUPER_ADMIN",
];

function isPortalRole(value: unknown): value is PortalRole {
  return (
    typeof value === "string" &&
    PORTAL_ROLES.some((role) => role === value)
  );
}

export async function requireEmployee(
  permittedRoles?: readonly PortalRole[]
): Promise<{
  id: string;
  email: string;
  role: PortalRole;
}> {
  const supabase = await createClient();

  const {
    data: { user },
    error,
  } = await supabase.auth.getUser();

  if (error || !user) {
    redirect("/portal/login");
  }

  const role = user.app_metadata?.role;

  if (!isPortalRole(role)) {
    redirect("/portal/unauthorized");
  }

  const employee = await prisma.employeeProfile.findUnique({
    where: {
      authUserId: user.id,
    },
    select: {
      email: true,
      role: true,
      status: true,
    },
  });

  if (!employee || employee.status !== "ACTIVE") {
    redirect("/portal/unauthorized");
  }

  if (employee.role !== role) {
    redirect("/portal/unauthorized");
  }

  // Require a personal password before workspace access.
  if (user.app_metadata?.must_change_password === true) {
    redirect("/portal/change-password");
  }

  // Super Admin may inspect all role-specific workspaces.
  if (
    permittedRoles &&
    role !== "SUPER_ADMIN" &&
    !permittedRoles.includes(role)
  ) {
    redirect("/portal/unauthorized");
  }

  return {
    id: user.id,
    email: user.email ?? employee.email,
    role,
  };
}
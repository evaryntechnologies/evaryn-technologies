generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InquiryStatus {
  NEW
  IN_DISCUSSION
  CLOSED
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  HIRED
  REJECTED
}

model ClientInquiry {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  service   String
  details   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model CustomServiceRequest {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String
  phoneOrCompany String?
  serviceArea    String
  requestTitle   String
  details        String        @db.Text
  expectedVolume String?
  neededBy       DateTime?
  exampleLink    String?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

model JobApplication {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  email         String
  phone         String
  role          String
  experience    String
  portfolioLink String?
  note          String            @db.Text
  cvStorageKey  String?
  status        ApplicationStatus @default(NEW)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}


// PHASE 1: External identities stay separate from authorized employees.
// Never create an EmployeeProfile or set an employee app_metadata role during public signup.
enum ExpertApprovalStatus {
  PENDING
  UNDER_REVIEW
  WAITLISTED
  APPROVED
  REJECTED
}

enum ClientAccountStatus {
  ACTIVE
  SUSPENDED
}

model ExpertApplication {
  id              String               @id @default(uuid()) @db.Uuid
  authUserId      String               @unique @db.Uuid
  email           String
  fullName        String
  country         String?
  expertise       String[]             @default([])
  experience      String?              @db.Text
  portfolioUrl    String?
  cvStorageKey    String?
  status          ExpertApprovalStatus @default(PENDING)
  reviewedById    String?              @db.Uuid
  reviewedAt      DateTime?
  decisionReason  String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model ClientProfile {
  id             String              @id @default(uuid()) @db.Uuid
  authUserId     String              @unique @db.Uuid
  email          String
  fullName       String
  companyName    String?
  phone          String?
  status         ClientAccountStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  projectAccess  ClientProjectAccess[]
  projectRequests ClientProjectRequest[]
  clientDeliveries ClientDelivery[]
  clientAssignments ClientOrderAssignment[]

  @@index([email])
  @@index([status])
}

// Clients are explicitly granted access to operational projects, never by guessing IDs.
model ClientProjectAccess {
  id              String        @id @default(uuid()) @db.Uuid
  clientId        String        @db.Uuid
  workProjectId   String        @db.Uuid
  createdAt       DateTime      @default(now())
  client          ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workProject     WorkProject   @relation(fields: [workProjectId], references: [id], onDelete: Cascade)

  @@unique([clientId, workProjectId])
  @@index([workProjectId])
}

// =====================================================
// EVARYN TECHNOLOGIES — EMPLOYEE AND TASK MANAGEMENT
// =====================================================

// One profile per authorized Supabase Auth user.
// authUserId corresponds to auth.users.id.

model EmployeeProfile {
  notifications PortalNotification[]
  resolvedIssues TaskDispute[] @relation("DisputeResolver")
  raisedIssues TaskDispute[] @relation("DisputeCreator")
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique @db.Uuid
  email      String   @unique
  fullName   String
  role       String
  status     String   @default("ACTIVE")
  department String?
  suspensionUntil DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  eligibleCategories EmployeeCategory[]
  assignedTasks WorkTask[]       @relation("TaskAssignee")
  createdTasks  WorkTask[]       @relation("TaskCreator")
  submissions   TaskSubmission[]
  reviews       TaskReview[]
  taskMessages TaskMessage[]
  reassignmentRequests TaskReassignmentRequest[]
  penalties TaskPenalty[]

  @@index([role, status])
}

model WorkProject {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String   @db.Text
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks WorkTask[]
  clientAccess ClientProjectAccess[]

  @@index([status])
}

model WorkTask {
  cancellationReason String? @db.Text
  clientPaidPercent Decimal? @db.Decimal(5,2)
  clientRevisionNote String? @db.Text
  disputes TaskDispute[]
  extraAttachments TaskExtraAttachment[]
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String?   @db.Uuid
  orderId      String?   @db.Text
  publicTaskId String?   @unique
  category     String?
  reviewDeadline DateTime?
  qaDeadline     DateTime?
  claimedReviewerId String? @db.Uuid
  claimedQaId String? @db.Uuid
  attachmentKey String?
  attachmentName String?
  title        String
  description  String    @db.Text
  instructions String?   @db.Text
  status       String    @default("ASSIGNED")
  priority     String    @default("NORMAL")
  deadline     DateTime?
  assignedToId String?   @db.Uuid
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  unitsOrdered Decimal? @db.Decimal(14,2)
  unitRate Decimal? @db.Decimal(14,2)
  totalOrderCost Decimal? @db.Decimal(16,2)
  billingUnit String?
  submissionHours Float?
  reviewHours Float?
  qaHours Float?

  project     WorkProject?     @relation(fields: [projectId], references: [id])
  assignedTo  EmployeeProfile? @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy   EmployeeProfile  @relation("TaskCreator", fields: [createdById], references: [id])
  submissions TaskSubmission[]
  messages TaskMessage[]
  reassignmentRequests TaskReassignmentRequest[]
  penalties TaskPenalty[]
  clientDelivery ClientDelivery?
  clientAssignment ClientOrderAssignment?
  clientRating Int?
  clientActionAt DateTime?
  reinstatedAt DateTime?
  reinstatedById String? @db.Uuid
  reinstatementCount Int @default(0)

  @@index([projectId, status])
  @@index([assignedToId, status])
  @@index([deadline])
}

model TaskSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @db.Uuid
  employeeId  String   @db.Uuid
  content     String   @db.Text
  fileUrl     String?
  status      String   @default("PENDING_REVIEW")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task     WorkTask        @relation(fields: [taskId], references: [id])
  employee EmployeeProfile @relation(fields: [employeeId], references: [id])
  reviews  TaskReview[]

  @@index([taskId, submittedAt])
  @@index([employeeId, status])
}

model TaskReview {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  reviewerId   String   @db.Uuid
  stage        String
  decision     String
  feedback     String?  @db.Text
  createdAt    DateTime @default(now())

  submission TaskSubmission  @relation(fields: [submissionId], references: [id])
  reviewer   EmployeeProfile @relation(fields: [reviewerId], references: [id])

  @@index([submissionId, stage])
  @@index([reviewerId, createdAt])
}

model TaskCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  rate Decimal @default(0) @db.Decimal(14,2)
  billingUnit String @default("TASK")
  employees EmployeeCategory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, name])
}

model EmployeeCategory {
  employeeId String @db.Uuid
  categoryId String @db.Uuid
  employee EmployeeProfile @relation(fields:[employeeId],references:[id],onDelete:Cascade)
  category TaskCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict)
  @@id([employeeId, categoryId])
  @@index([categoryId])
}

model TaskMessage {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  senderId String @db.Uuid
  body String @db.Text
  createdAt DateTime @default(now())
  task WorkTask @relation(fields:[taskId], references:[id],onDelete:Restrict)
  sender EmployeeProfile @relation(fields:[senderId],references:[id],onDelete:Restrict)
  @@index([taskId,createdAt])
  recipientRole String @default("GENERAL")
}
model TaskReassignmentRequest {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  employeeId String @db.Uuid
  reason String @db.Text
  status String @default("PENDING")
  adminNote String? @db.Text
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Restrict)
  employee EmployeeProfile @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  @@index([status,createdAt])
  @@index([taskId,employeeId])
}
model TaskPenalty {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  createdById String @db.Uuid
  reason String
  amount Decimal @db.Decimal(14,2)
  note String @db.Text
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Restrict)
  createdBy EmployeeProfile @relation(fields:[createdById],references:[id],onDelete:Restrict)
  @@index([taskId,status])
}


// Additional files attached to an existing work task.
model TaskExtraAttachment {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  uploadedById String @db.Uuid
  storageKey String @unique
  fileName String
  contentType String
  createdAt DateTime @default(now())

task WorkTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@index([taskId, createdAt])
}
model TaskDispute {
  id String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  raisedById String @db.Uuid
  resolvedById String? @db.Uuid
  reason String @db.Text
  resolution String? @db.Text
  status String @default("OPEN")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  task WorkTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  raisedBy EmployeeProfile @relation("DisputeCreator", fields: [raisedById], references: [id], onDelete: Restrict)
  resolvedBy EmployeeProfile? @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  @@index([taskId, status])
  @@index([status, createdAt])
}
model PortalNotification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  title String
  body String @db.Text
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  recipient EmployeeProfile @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  @@index([recipientId, createdAt])
}
// Phase 3: authenticated client service requests, separate from operational tasks.
enum ClientProjectRequestStatus {
  PENDING_REVIEW
  IN_DISCUSSION
  ACCEPTED
  CLOSED
  REJECTED
}

model ClientProjectRequest {
  id        String                     @id @default(uuid()) @db.Uuid
  clientId  String                     @db.Uuid
  client    ClientProfile              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  service   String
  details   String                     @db.Text
  status    ClientProjectRequestStatus @default(PENDING_REVIEW)
  adminNote String?                    @db.Text
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  @@index([clientId, createdAt])
  @@index([status, createdAt])
}

model ClientDelivery {
  id String @id @default(uuid()) @db.Uuid
  taskId String @unique @db.Uuid
  clientId String @db.Uuid
  publishedById String @db.Uuid
  storageKey String
  fileName String
  publishedAt DateTime @default(now())
  rating Int?
  feedback String? @db.Text
  ratedAt DateTime?
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Restrict)
  client ClientProfile @relation(fields:[clientId],references:[id],onDelete:Restrict)
  @@index([clientId,publishedAt])
}

model ClientOrderAssignment {
  id String @id @default(uuid()) @db.Uuid
  taskId String @unique @db.Uuid
  clientId String @db.Uuid
  assignedById String @db.Uuid
  createdAt DateTime @default(now())
  task WorkTask @relation(fields:[taskId],references:[id],onDelete:Restrict)
  client ClientProfile @relation(fields:[clientId],references:[id],onDelete:Restrict)
  updates ClientOrderUpdate[]
  @@index([clientId,createdAt])
}
model ClientOrderUpdate {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  stage String
  message String @db.Text
  postedById String @db.Uuid
  createdAt DateTime @default(now())
  assignment ClientOrderAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict)
  @@index([assignmentId,createdAt])
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InquiryStatus {
  NEW
  IN_DISCUSSION
  CLOSED
}

enum ApplicationStatus {
  NEW
  SHORTLISTED
  HIRED
  REJECTED
}

model ClientInquiry {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  service   String
  details   String        @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model CustomServiceRequest {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String
  phoneOrCompany String?
  serviceArea    String
  requestTitle   String
  details        String        @db.Text
  expectedVolume String?
  neededBy       DateTime?
  exampleLink    String?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

model JobApplication {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  email         String
  phone         String
  role          String
  experience    String
  portfolioLink String?
  note          String            @db.Text
  cvStorageKey  String?
  status        ApplicationStatus @default(NEW)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}
